{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Django",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\manage.py",
      "args": ["runserver", "127.0.0.1:8000", "--noreload"],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    },
    {
      "name": "Debug review tests",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}\\manage.py",
      "args": ["test", "reviews"],
      "django": true,
      "justMyCode": true,
      "console": "integratedTerminal"
    }
  ]
}
